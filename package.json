{
  "name": "notekeep-studio-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm --prefix backend run dev\" \"npm --prefix client run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:client": "npm --prefix client run dev",
    "build:backend": "npm --prefix backend run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:backend && npm run build:client",
    "start": "npm --prefix backend start",
    "prisma:studio": "npm --prefix backend run prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
